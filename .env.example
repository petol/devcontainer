# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is gitignored — never commit real values there.

# GitHub identity seeded into the agent's CLAUDE.md/AGENTS.md environment notes.
GITHUB_USERNAME=yourusername
GITHUB_EMAIL=you@example.com

# Home LAN firewall: DNS_IP is allowed through, everything else in
# LAN_BLOCK_RANGE is dropped on outbound. General internet access is not
# affected — this is a LAN block, not an allowlist. Both are required; `dev`
# refuses to start without them since this is a security-relevant rule.
DNS_IP=192.168.1.1
LAN_BLOCK_RANGE=192.168.0.0/16

# Ollama server on the host, reachable from the container via Podman's pasta
# networking. host.containers.internal is the standard Podman host alias and
# works for most setups — override only if yours resolves differently.
OLLAMA_HOST=host.containers.internal
OLLAMA_PORT=11434

# Requesty (router.requesty.ai) API key, optional. If set, opencode is
# pre-configured with a "requesty" provider giving access to whatever models
# your Requesty org has approved. Leave unset/blank to skip it entirely.
REQUESTY_API_KEY=
