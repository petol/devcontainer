#!/usr/bin/env bash
set -e

# Canonicalize through the ~/.local/bin/dev symlink (the standard install
# method, see README) so lib/ resolves correctly regardless of where dev is
# invoked from. A bare `dirname "$0"` would resolve to ~/.local/bin instead.
SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" &>/dev/null && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"

CONTAINER="arch-dev-persistent"
IMAGE="arch-dev"

# ─── Local config (.env) ───────────────────────────────────────────────────────
# GitHub identity, firewall targets, and the Ollama host live in .env
# (gitignored) rather than hardcoded here, since this repo is public — see
# .env.example for the template. Validated below, after flag parsing, so
# --help still works without a .env file present.

if [[ -f "$SCRIPT_DIR/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/.env"
    set +a
fi

: "${OLLAMA_HOST:=host.containers.internal}"
: "${OLLAMA_PORT:=11434}"

# ─── Flags ────────────────────────────────────────────────────────────────────

REBUILD=false
FLUSH=false
UPGRADE=false
RESTART=false
UPDATE_NOTES=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help)
            echo "Usage: dev [--rebuild] [--flush] [--upgrade] [--restart] [--update-notes] [path]"
            echo "  --rebuild       force image rebuild"
            echo "  --flush         remove persistent volumes (agent auth and binaries;"
            echo "                  does NOT remove dev-audit, the shell audit log)"
            echo "  --upgrade       reinstall claude code, codex, and opencode, preserve auth"
            echo "  --restart       stop/remove the running container first, so it is"
            echo "                  recreated with the given path mounted (e.g. to switch"
            echo "                  projects) instead of just attaching to the old one"
            echo "  --update-notes  overwrite the seeded CLAUDE.md/AGENTS.md in the auth"
            echo "                  volumes with the current template, without flushing"
            echo "                  auth (normally these are only written once)"
            echo "  path            project dir to mount (default: \$PWD)"
            exit 0
            ;;
        --rebuild)      REBUILD=true; shift ;;
        --flush)        FLUSH=true; shift ;;
        --upgrade)      UPGRADE=true; shift ;;
        --restart)      RESTART=true; shift ;;
        --update-notes) UPDATE_NOTES=true; shift ;;
        *)              break ;;
    esac
done

if [[ -z "${GITHUB_USERNAME:-}" || -z "${GITHUB_EMAIL:-}" || -z "${DNS_IP:-}" || -z "${LAN_BLOCK_RANGE:-}" ]]; then
    echo "error: GITHUB_USERNAME, GITHUB_EMAIL, DNS_IP, and LAN_BLOCK_RANGE must be set." >&2
    echo "       Run: cp \"$SCRIPT_DIR/.env.example\" \"$SCRIPT_DIR/.env\" and fill in your values." >&2
    exit 1
fi

WORKSPACE="${1:-$PWD}"
WORKSPACE="$(realpath "$WORKSPACE")"

# Not printed here: whether $WORKSPACE actually ends up mounted depends on
# whether a container is already running (see Attach or start below) — if
# one is and --restart wasn't passed, this path is never used. Each branch
# below prints the workspace that's actually in play, once that's known.
[[ "$REBUILD"      == true ]] && echo "  rebuild      : yes"
[[ "$FLUSH"        == true ]] && echo "  flush        : yes"
[[ "$UPGRADE"      == true ]] && echo "  upgrade      : yes"
[[ "$RESTART"      == true ]] && echo "  restart      : yes"
[[ "$UPDATE_NOTES" == true ]] && echo "  update-notes : yes"

if [[ "$FLUSH" == true ]]; then
    echo "→ Flushing volumes..."
    podman volume rm -f claude-auth claude-local codex-auth 2>/dev/null || true
fi

if [[ "$UPGRADE" == true ]]; then
    echo "→ Upgrading Claude Code, Codex, and opencode..."
    # Clears the install stamp Claude's entrypoint check gates on, so it
    # reinstalls on next start. This runs before the "Volumes" section below
    # creates claude-auth, so on a first-ever --upgrade (or --flush --upgrade
    # in one invocation) the volume may not exist yet — guard explicitly
    # rather than let an empty Mountpoint silently turn this into `rm -f
    # /.installed` on the host.
    CLAUDE_AUTH_MOUNT="$(podman volume inspect claude-auth --format '{{.Mountpoint}}' 2>/dev/null)"
    [ -n "$CLAUDE_AUTH_MOUNT" ] && rm -f "$CLAUDE_AUTH_MOUNT/.installed"
    # Codex and opencode have no install stamp of their own — their entrypoint
    # checks are just "does the binary exist", so removing claude-local below
    # (where both binaries live) is what actually forces their reinstall.
    podman volume rm -f claude-local 2>/dev/null || true
fi

if [[ "$REBUILD" == true ]]; then
    echo "→ Removing old image..."
    podman rmi -f "$IMAGE" 2>/dev/null || true
fi

# ─── Environment notes ────────────────────────────────────────────────────────
# Single source of truth for both the entrypoint's first-run seeding and
# --update-notes' forced overwrite, so the two paths can't drift out of sync.
# Placeholders are substituted via sed on plain file text — not spliced into
# any shell-parsed string — so this stays safe even if a value (e.g. an
# email address) contains characters that would break naive interpolation.

ENV_NOTES="$(sed \
    -e "s#{{GITHUB_USERNAME}}#$GITHUB_USERNAME#g" \
    -e "s#{{GITHUB_EMAIL}}#$GITHUB_EMAIL#g" \
    -e "s#{{DNS_IP}}#$DNS_IP#g" \
    -e "s#{{LAN_BLOCK_RANGE}}#$LAN_BLOCK_RANGE#g" \
    -e "s#{{OLLAMA_HOST}}#$OLLAMA_HOST#g" \
    -e "s#{{OLLAMA_PORT}}#$OLLAMA_PORT#g" \
    "$LIB_DIR/env-notes.md")"

# ─── Image definition ─────────────────────────────────────────────────────────

build_image() {
    echo "→ Building image..."
    podman build -t "$IMAGE" - < "$LIB_DIR/Containerfile"
}

# ─── Entrypoint (injected into container on start) ────────────────────────────

ENTRYPOINT_SCRIPT="$(cat "$LIB_DIR/entrypoint.sh")"

# ─── Volumes ──────────────────────────────────────────────────────────────────

podman volume create claude-auth 2>/dev/null || true
podman volume create claude-local 2>/dev/null || true
podman volume create codex-auth 2>/dev/null || true
podman volume create dev-audit 2>/dev/null || true

if [[ "$UPDATE_NOTES" == true ]]; then
    echo "→ Updating environment notes..."
    # Write straight to each volume's host-side mountpoint, so this works
    # whether or not the container is currently running and without needing
    # --flush (which would also wipe auth).
    CLAUDE_AUTH_MOUNT="$(podman volume inspect claude-auth --format '{{.Mountpoint}}' 2>/dev/null)"
    CODEX_AUTH_MOUNT="$(podman volume inspect codex-auth --format '{{.Mountpoint}}' 2>/dev/null)"
    if [ -n "$CLAUDE_AUTH_MOUNT" ]; then
        echo "$ENV_NOTES" > "$CLAUDE_AUTH_MOUNT/CLAUDE.md"
    fi
    if [ -n "$CODEX_AUTH_MOUNT" ]; then
        echo "$ENV_NOTES" > "$CODEX_AUTH_MOUNT/AGENTS.md"
    fi
fi

# ─── Build if missing ─────────────────────────────────────────────────────────

if ! podman image exists "$IMAGE"; then
    build_image
fi

# ─── Restart ──────────────────────────────────────────────────────────────────
# Stop/remove the existing container so the logic below always falls through
# to creating a fresh one (e.g. to mount a different workspace) instead of
# just attaching to whatever is already running.

if [[ "$RESTART" == true ]] && podman container inspect "$CONTAINER" &>/dev/null 2>&1; then
    echo "→ Restarting: stopping existing container..."
    podman stop "$CONTAINER" >/dev/null 2>&1 || true
    podman rm "$CONTAINER" >/dev/null 2>&1 || true
fi

# ─── Attach or start ──────────────────────────────────────────────────────────

if podman container inspect "$CONTAINER" &>/dev/null 2>&1; then
    if [ "$(podman inspect -f '{{.State.Running}}' "$CONTAINER")" = "true" ]; then
        RUNNING_WORKSPACE="$(podman inspect -f '{{range .Mounts}}{{if eq .Destination "/code"}}{{.Source}}{{end}}{{end}}' "$CONTAINER")"
        echo "→ Container already running, attaching (workspace: $RUNNING_WORKSPACE)"
        if [[ "$RUNNING_WORKSPACE" != "$WORKSPACE" ]]; then
            echo "  note: this differs from the requested path ($WORKSPACE)."
            echo "        pass --restart to recreate the container mounting it instead."
        fi
        podman exec -it -w /code \
            "$CONTAINER" /bin/zsh
        exit 0
    else
        podman rm "$CONTAINER" >/dev/null
    fi
fi

echo "→ Starting container, workspace: $WORKSPACE"

# Write entrypoint to a temp file
TMPEP=$(mktemp /tmp/dev-entrypoint-XXXXXX.sh)
chmod 0600 "$TMPEP"
TMPNOTES=$(mktemp /tmp/dev-notes-XXXXXX.md)
chmod 0600 "$TMPNOTES"
printf '%s\n' "$ENV_NOTES" > "$TMPNOTES"
trap 'rm -f "$TMPEP" "$TMPNOTES"' EXIT INT TERM HUP
echo "$ENTRYPOINT_SCRIPT" > "$TMPEP"
chmod 0700 "$TMPEP"

podman run -d \
    --name "$CONTAINER" \
    --cap-drop=ALL \
    --cap-add=CHOWN --cap-add=DAC_OVERRIDE --cap-add=FOWNER --cap-add=FSETID \
    --cap-add=KILL --cap-add=SETGID --cap-add=SETUID --cap-add=SETPCAP \
    --cap-add=NET_BIND_SERVICE --cap-add=SYS_CHROOT --cap-add=SETFCAP \
    --security-opt no-new-privileges \
    --memory=24g --memory-swap=24g --pids-limit=4096 \
    -e OLLAMA_HOST="$OLLAMA_HOST" \
    -e OLLAMA_PORT="$OLLAMA_PORT" \
    -v "${WORKSPACE}:/code:z" \
    -v "claude-auth:/root/.claude:z" \
    -v "claude-local:/root/.local:z" \
    -v "codex-auth:/root/.codex:z" \
    -v "dev-audit:/root/.audit:z" \
    -v "$TMPEP:/entrypoint.sh:z" \
    -v "$TMPNOTES:/etc/dev-env-notes:ro,z" \
    -w /code \
    --entrypoint /entrypoint.sh \
    "$IMAGE" \
    sleep infinity

# ─── Network policy ────────────────────────────────────────────────────────────
# Block the home LAN, except the DNS server; general internet stays open (no
# allowlist). Applied by a short-lived helper that joins the container's
# network namespace with a transient NET_ADMIN — the main container above never
# gets that capability, so nothing running inside it can remove this rule.
# DNS_IP/LAN_BLOCK_RANGE reach the nft rule via -e (container env), expanded
# by the container's own sh when it runs the script below — never spliced
# into this string on the host side.

echo "→ Applying network policy (blocking LAN, allowing DNS + internet)..."
podman run --rm \
    --network "container:$CONTAINER" \
    --cap-add=NET_ADMIN \
    -e DNS_IP="$DNS_IP" \
    -e LAN_BLOCK_RANGE="$LAN_BLOCK_RANGE" \
    "$IMAGE" \
    sh -c '
        nft add table inet devfw
        nft add chain inet devfw output "{ type filter hook output priority filter ; policy accept ; }"
        nft add rule inet devfw output ip daddr "$DNS_IP" accept
        nft add rule inet devfw output ip daddr "$LAN_BLOCK_RANGE" drop
    '

echo "→ Attaching, workspace: $WORKSPACE"
podman exec -it -w /code \
    "$CONTAINER" /bin/zsh
